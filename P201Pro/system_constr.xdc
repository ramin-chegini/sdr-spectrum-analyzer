set_property IOSTANDARD LVCMOS33 [get_ports led_trf_rx2]
set_property PULLDOWN true [get_ports led_trf_rx2]


create_clock -period 16.270 -name rx_clk [get_ports rx_clk_in]

create_clock -period 10.000 -name clk_fpga_0 [get_pins {i_system_wrapper/system_i/sys_ps7/inst/PS7_i/FCLKCLK[0]}]
create_clock -period 5.000 -name clk_fpga_1 [get_pins {i_system_wrapper/system_i/sys_ps7/inst/PS7_i/FCLKCLK[1]}]

set_input_jitter clk_fpga_0 0.300
set_input_jitter clk_fpga_1 0.150


# MDIO
set_property PACKAGE_PIN B19 [get_ports mdio_port_0_mdc]
set_property IOSTANDARD LVCMOS33 [get_ports mdio_port_0_mdc]

set_property PACKAGE_PIN A20 [get_ports mdio_port_0_mdio_io]
set_property IOSTANDARD LVCMOS33 [get_ports mdio_port_0_mdio_io]

# TX path
set_property PACKAGE_PIN E17 [get_ports rgmii_port_0_txc]
set_property IOSTANDARD LVCMOS33 [get_ports rgmii_port_0_txc]

set_property PACKAGE_PIN E19 [get_ports rgmii_port_0_tx_ctl]
set_property IOSTANDARD LVCMOS33 [get_ports rgmii_port_0_tx_ctl]

set_property PACKAGE_PIN D18 [get_ports {rgmii_port_0_td[0]}]
set_property PACKAGE_PIN D19 [get_ports {rgmii_port_0_td[1]}]
set_property PACKAGE_PIN D20 [get_ports {rgmii_port_0_td[2]}]
set_property PACKAGE_PIN E18 [get_ports {rgmii_port_0_td[3]}]

set_property IOSTANDARD LVCMOS33 [get_ports {rgmii_port_0_td[*]}]

# RX path
set_property PACKAGE_PIN H16 [get_ports rgmii_port_0_rxc]
set_property IOSTANDARD LVCMOS33 [get_ports rgmii_port_0_rxc]

set_property PACKAGE_PIN M17 [get_ports rgmii_port_0_rx_ctl]
set_property IOSTANDARD LVCMOS33 [get_ports rgmii_port_0_rx_ctl]

set_property PACKAGE_PIN F16 [get_ports {rgmii_port_0_rd[0]}]
set_property PACKAGE_PIN F17 [get_ports {rgmii_port_0_rd[1]}]
set_property PACKAGE_PIN M19 [get_ports {rgmii_port_0_rd[2]}]
set_property PACKAGE_PIN M20 [get_ports {rgmii_port_0_rd[3]}]

set_property IOSTANDARD LVCMOS33 [get_ports {rgmii_port_0_rd[*]}]




