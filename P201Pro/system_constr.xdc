#set_input_delay -clock rgmii_rxc -min -2.8 #[get_ports {rgmii_port_0_rd[*] rgmii_port_0_rx_ctl}]

#set_input_delay -clock rgmii_rxc -clock_fall -add_delay -max -1.2 #[get_ports {rgmii_port_0_rd[*] rgmii_port_0_rx_ctl}]

#set_input_delay -clock rgmii_rxc -clock_fall -add_delay -min -2.8 #[get_ports {rgmii_port_0_rd[*] rgmii_port_0_rx_ctl}]

## Use these constraints to modify output delay on RGMII signals if 2ns delay is added by external PHY

#set_output_delay -clock rgmii_txc -max -1.0 #[get_ports {rgmii_port_0_td[*] rgmii_port_0_tx_ctl}]

#set_output_delay -clock rgmii_txc -min -2.5 #[get_ports {rgmii_port_0_td[*] rgmii_port_0_tx_ctl}]

#set_output_delay -clock rgmii_txc -clock_fall -max -1.0 #[get_ports {rgmii_port_0_td[*] rgmii_port_0_tx_ctl}]

#set_output_delay -clock rgmii_txc -clock_fall -min -2.5 #[get_ports {rgmii_port_0_td[*] rgmii_port_0_tx_ctl}]



#set_property SLEW FAST [get_ports  rgmii_port_0_txc]
#set_property SLEW FAST [get_ports  rgmii_port_0_tx_ctl]
#set_property SLEW FAST [get_ports {rgmii_port_0_td[*]}]



create_clock -period 8.000 -name rgmii_txc [get_ports rgmii_port_0_txc]
create_clock -period 8.000 -name rgmii_rxc [get_ports rgmii_port_0_rxc]

#False path constraints to async inputs coming directly to synchronizer
set_false_path -to [get_pins -hier -filter {name =~ *idelayctrl_reset_gen/*reset_sync*/PRE }]
set_false_path -to [get_pins -of [get_cells -hier -filter { name =~ *i_MANAGEMENT/SYNC_*/data_sync* }] -filter { name =~ *D }]
set_false_path -to [get_pins -hier -filter {name =~ *reset_sync*/PRE }]

#False path constraints from Control Register outputs
set_false_path -from [get_pins -hier -filter {name =~ *i_MANAGEMENT/DUPLEX_MODE_REG*/C }]
set_false_path -from [get_pins -hier -filter {name =~ *i_MANAGEMENT/SPEED_SELECTION_REG*/C }]

# constraint valid if parameter C_EXTERNAL_CLOCK = 0
set_case_analysis 0 [get_pins -hier -filter {name =~ *i_bufgmux_gmii_clk/CE0}]
set_case_analysis 0 [get_pins -hier -filter {name =~ *i_bufgmux_gmii_clk/S0}]
set_case_analysis 1 [get_pins -hier -filter {name =~ *i_bufgmux_gmii_clk/CE1}]
set_case_analysis 1 [get_pins -hier -filter {name =~ *i_bufgmux_gmii_clk/S1}]

# These constraints are for non-Versal devices
# To Adjust GMII Rx Input Setup/Hold Timing
# IDELAY_VALUE and DELAY_VALUE support depends on the device family
# IDELAY_VALUE is used for 7-series Zynq devices
# DELAY_VALUE is used for Zynq UltraScale+ devices

set_property IDELAY_VALUE 16 [get_cells -hier -filter {name =~*delay_rgmii_rx_ctl}]

set_property IDELAY_VALUE 16 [get_cells -hier -filter {name =~ *delay_rgmii_rxd*}]

set_property IODELAY_GROUP gpr1 [get_cells -hier -filter {name =~ *delay_rgmii_rx_ctl}]

set_property IODELAY_GROUP gpr1 [get_cells -hier -filter {name =~*delay_rgmii_rxd*}]

set_property IODELAY_GROUP gpr1 [get_cells -hier -filter {name =~ *idelayctrl}]

#These constraints are for non-Versal devices
#To adjust RGMII TXC delay when 2 ns skew option is selected


# Use these constraints to modify input delay on RGMII signals

set_input_delay -clock [get_clocks rgmii_rxc] -max -1.200 [get_ports {{rgmii_port_0_rd[*]} rgmii_port_0_rx_ctl}]

set_input_delay -clock [get_clocks rgmii_rxc] -min -2.800 [get_ports {{rgmii_port_0_rd[*]} rgmii_port_0_rx_ctl}]

set_input_delay -clock [get_clocks rgmii_rxc] -clock_fall -max -add_delay -1.200 [get_ports {{rgmii_port_0_rd[*]} rgmii_port_0_rx_ctl}]

set_input_delay -clock [get_clocks rgmii_rxc] -clock_fall -min -add_delay -2.800 [get_ports {{rgmii_port_0_rd[*]} rgmii_port_0_rx_ctl}]

# Use these constraints to modify output delay on RGMII signals if 2ns delay is added by external PHY

set_output_delay -clock [get_clocks rgmii_txc] -max -1.000 [get_ports {{rgmii_port_0_td[*]} rgmii_port_0_tx_ctl}]

set_output_delay -clock [get_clocks rgmii_txc] -min -2.600 [get_ports {{rgmii_port_0_td[*]} rgmii_port_0_tx_ctl}]

set_output_delay -clock [get_clocks rgmii_txc] -clock_fall -max -1.000 [get_ports {{rgmii_port_0_td[*]} rgmii_port_0_tx_ctl}]

set_output_delay -clock [get_clocks rgmii_txc] -clock_fall -min -2.600 [get_ports {{rgmii_port_0_td[*]} rgmii_port_0_tx_ctl}]


set_property SLEW FAST [get_ports {rgmii_port_0_td[3]}]
set_property SLEW FAST [get_ports {rgmii_port_0_td[2]}]
set_property SLEW FAST [get_ports {rgmii_port_0_td[1]}]
set_property SLEW FAST [get_ports {rgmii_port_0_td[0]}]
set_property SLEW FAST [get_ports rgmii_port_0_txc]
set_property SLEW FAST [get_ports rgmii_port_0_tx_ctl]




set_property IOSTANDARD SSTL15_T_DCI [get_ports *fixed_io_ddr_vr*]
set_property SLEW FAST [get_ports *fixed_io_ddr_vr*]


set_property IOSTANDARD DIFF_SSTL15 [get_ports ddr_ck_n]
set_property IOSTANDARD DIFF_SSTL15 [get_ports ddr_ck_p]
set_property SLEW FAST [get_ports ddr_ck_n]
